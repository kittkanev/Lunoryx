<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Luaryx.Worker</AssemblyName><InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifiers>linux-x64;win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed><DebugType>embedded</DebugType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" /></ItemGroup>
</Project>
